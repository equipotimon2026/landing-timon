# Variables de entorno de la landing (timonear.com).
# Copiá este archivo a .env.local para desarrollo. Las de producción se cargan
# en Vercel. Las que empiezan con NEXT_PUBLIC_ viajan al navegador: nada secreto.

# Pixel de Meta, solo para las sublandings de pauta (/video1, /video2...).
# Si está vacío, el pixel no carga y la página anda igual (previews y local).
# El ID lo manda Meta; el actual lo pasó Juan Bautista Ferraris (20/11/2026).
NEXT_PUBLIC_META_PIXEL_ID=30458212343778464

# La app. Vacío apunta a producción (https://app.timonear.com).
NEXT_PUBLIC_APP_URL=

# Link para agendar una llamada (lo usa el formulario de padres).
NEXT_PUBLIC_AGENDA_URL=

# Secreto compartido con la app: la landing lo manda en `x-landing-secret`
# al postear los leads del formulario de padres a /api/familias.
LANDING_LEADS_SECRET=

# Resend, para los mails de /api/contact y /api/padres.
RESEND_API_KEY=
